{
  "manifest_version": 3,
  "name": "Panop Bookmark Bridge",
  "version": "1.0.0",
  "description": "Writes Panop's queued bookmarks live into Chrome using the bookmarks API — no need to close Chrome.",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Panop Bookmark Bridge",
    "default_popup": "popup.html"
  }
}
